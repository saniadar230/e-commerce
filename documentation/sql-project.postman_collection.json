    {
      "name": "Stripe Webhook",
      "item": [
        {
          "name": "checkout.session.completed (signed test event)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.collectionVariables.get(\"stripeWebhookSecret\");",
                  "if (!secret) throw new Error(\"Set the stripeWebhookSecret collection variable from Stripe CLI.\");",
                  "pm.variables.set(\"stripeEventId\", \"evt_\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "const payload = pm.variables.replaceIn(pm.request.body.raw);",
                  "const timestamp = Math.floor(Date.now() / 1000);",
                  "const signedPayload = `${timestamp}.${payload}`;",
                  "const signature = CryptoJS.HmacSHA256(signedPayload, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"Stripe-Signature\", value: `t=${timestamp},v1=${signature}` });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{stripeEventId}}\",\n  \"object\": \"event\",\n  \"created\": 1730000000,\n  \"data\": {\n    \"object\": {\n      \"id\": \"cs_test_postman\",\n      \"object\": \"checkout.session\",\n      \"payment_status\": \"paid\",\n      \"amount_total\": {{amountCents}},\n      \"currency\": \"usd\",\n      \"payment_intent\": \"pi_test_postman\",\n      \"metadata\": {\n        \"payment_id\": \"{{paymentId}}\",\n        \"order_id\": \"{{orderId}}\"\n      }\n    }\n  },\n  \"livemode\": false,\n  \"type\": \"checkout.session.completed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/webhooks/stripe/",
            "description": "Posts a signed Stripe test event. Use the whsec_ signing secret printed by `stripe listen --forward-to localhost:3000/webhooks/stripe/`; paymentId and amountCents must match a pending card payment. The current controller uses STRIPE_SECRET_KEY for webhook verification, so it must use the endpoint signing secret for this request to be accepted."
          },
          "response": []
        }
      ]
    }
  ]
}

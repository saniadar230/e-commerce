    {
      "name": "Order Items",
      "item": [
        {
          "name": "List Order Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data[0] && json.data[0].order_item_id) {",
                  "        pm.collectionVariables.set(\"orderItemId\", json.data[0].order_item_id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/order-items?pageNo=1&pageSize=10&sortBy=desc",
            "description": "Lists an order's items and saves the first returned `order_item_id` for update/delete requests. An existing order with no items returns an empty list; a nonexistent order returns `404`."
          },
          "response": []
        },
        {
          "name": "Add Order Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    const item = Array.isArray(json.data) ? json.data[0] : json.data;",
                  "    if (item && item.order_item_id) pm.collectionVariables.set(\"orderItemId\", item.order_item_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [

{
  "info": {
    "_postman_id": "21fbb8b8-3051-4aec-9b05-c3f380fbdd23",
    "name": "SQL Project API",
    "description": "Postman collection for every active Express route in the SQL Project API. Run the server with `npm run dev`; it listens on port 3000. Create requests save returned IDs into collection variables for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response status is successful\", function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "customerId", "value": "1", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "orderId", "value": "1", "type": "string" },
    { "key": "orderItemId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers?pageNo=1&pageSize=10&sortBy=asc&search=",
            "description": "Returns a paginated customer list. `search` matches the beginning of customer names or email addresses."
          },
          "response": []
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}",
            "description": "Returns the selected customer. Returns `404` when `customerId` does not exist."
          },
          "response": []
        },
        {
          "name": "Get Customer Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}/orders?pageNo=1&pageSize=10&sortBy=desc",
            "description": "Returns a customer's orders. An existing customer with no orders returns an empty list; a nonexistent customer returns `404`."
          },
          "response": []
        },
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    const customer = Array.isArray(json.data) ? json.data[0] : json.data;",
                  "    if (customer && customer.customer_id) pm.collectionVariables.set(\"customerId\", customer.customer_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Ayesha Khan\",\n  \"email\": \"ayesha.khan@example.com\",\n  \"city\": \"Karachi\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/customers"
          },
          "response": []
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Ayesha Ahmed\",\n  \"city\": \"Lahore\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/customers/{{customerId}}",
            "description": "Updates the selected customer. Returns `404` when `customerId` does not exist."
          },
          "response": []
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}",
            "description": "Deletes the selected customer. Returns `404` when `customerId` does not exist."
          },
          "response": []
        }
      ]
    },
